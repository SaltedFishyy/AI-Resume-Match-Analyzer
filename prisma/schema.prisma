generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  clerkId             String               @unique
  email               String               @unique
  analyses            ResumeAnalysis[]
  dailyAnalysisUsages DailyAnalysisUsage[]
  profile             UserProfile?
  masterResume        MasterResume?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ResumeAnalysis {
  id                String   @id @default(cuid())
  userId            String
  resumeText         String   @db.Text
  jobDescription     String   @db.Text
  matchScore         Int
  strengths          String[]
  missingKeywords    String[]
  skillGaps          String[]
  bulletSuggestions  String[]
  actionPlan         String[]
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DailyAnalysisUsage {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model UserProfile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  legalName                   String?
  preferredName               String?
  contactEmail                String?
  phone                       String?
  city                        String?
  state                       String?
  country                     String?
  linkedInUrl                 String?
  githubUrl                   String?
  portfolioUrl                String?
  workAuthorizationStatus     String?
  requiresSponsorshipNow      Boolean?
  requiresSponsorshipInFuture Boolean?
  earliestStartDate           DateTime? @db.Date
  relocationPreference        String?
  commonRoleTargets           String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MasterResume {
  id          String             @id @default(cuid())
  userId      String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   ResumeEducation[]
  experiences ResumeExperience[]
  projects    ResumeProject[]
  skills      ResumeSkill[]
  bullets     ResumeBullet[]
}

model ResumeEducation {
  id             String       @id @default(cuid())
  masterResumeId String
  school         String
  degree         String?
  fieldOfStudy   String?
  location       String?
  startDate      String?
  endDate        String?
  notes          String?
  position       Int
  masterResume   MasterResume @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)

  @@index([masterResumeId, position])
}

model ResumeExperience {
  id             String         @id @default(cuid())
  masterResumeId String
  company        String
  title          String
  location       String?
  startDate      String?
  endDate        String?
  isCurrent      Boolean        @default(false)
  technologies   String[]       @default([])
  position       Int
  masterResume   MasterResume   @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)
  bullets        ResumeBullet[]

  @@index([masterResumeId, position])
}

model ResumeProject {
  id             String         @id @default(cuid())
  masterResumeId String
  name           String
  url            String?
  repositoryUrl  String?
  technologies   String[]       @default([])
  startDate      String?
  endDate        String?
  position       Int
  masterResume   MasterResume   @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)
  bullets        ResumeBullet[]

  @@index([masterResumeId, position])
}

model ResumeSkill {
  id             String       @id @default(cuid())
  masterResumeId String
  name           String
  category       String?
  position       Int
  masterResume   MasterResume @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)

  @@index([masterResumeId, position])
}

model ResumeBullet {
  id             String           @id @default(cuid())
  masterResumeId String
  experienceId   String?
  projectId      String?
  text           String           @db.Text
  tags           String[]         @default([])
  provenance     BulletProvenance
  sourceNote     String?
  position       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  masterResume   MasterResume     @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)
  experience     ResumeExperience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project        ResumeProject?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([masterResumeId, position])
  @@index([experienceId, position])
  @@index([projectId, position])
}

enum BulletProvenance {
  USER_ENTERED
  IMPORTED_FROM_RESUME_TEXT
  IMPORTED_FROM_PDF
  USER_CONFIRMED_AI_SUGGESTION
}
